# Backend API URL
VITE_API_URL=http://localhost:4000/api

# Test credentials for development
VITE_TEST_EMAIL=test@example.com
VITE_TEST_PASSWORD=password123
# Optional: set to true to auto-login test account in dev
VITE_ENABLE_DEV_AUTO_LOGIN=false

# Backend server configuration
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@localhost:5432/circulink
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10
PORT=4000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# LLM (OpenAI-compatible)
# OpenAI default:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# SiliconFlow example:
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=<your-siliconflow-model-id>
