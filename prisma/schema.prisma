generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ItemStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String?
  role          Role            @default(USER)
  items         Item[]
  favorites     Favorite[]
  messages      Message[]
  threadsAsBuyer  MessageThread[] @relation("buyerThreads")
  threadsAsSeller MessageThread[] @relation("sellerThreads")
  ordersAsBuyer   Order[]         @relation("ordersAsBuyer")
  ordersAsSeller  Order[]         @relation("ordersAsSeller")
  refreshTokens RefreshToken[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  items     Item[]
  createdAt DateTime @default(now())
}

model Item {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Decimal     @db.Decimal(12, 2)
  condition   Condition
  status      ItemStatus  @default(ACTIVE)
  categoryId  String
  sellerId    String
  images      String[]
  category    Category    @relation(fields: [categoryId], references: [id])
  seller      User        @relation(fields: [sellerId], references: [id])
  favorites   Favorite[]
  threads     MessageThread[]
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  user      User     @relation(fields: [userId], references: [id])
  item      Item     @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

model MessageThread {
  id        String   @id @default(cuid())
  itemId    String
  buyerId   String
  sellerId  String
  item      Item     @relation(fields: [itemId], references: [id])
  buyer     User     @relation("buyerThreads", fields: [buyerId], references: [id])
  seller    User     @relation("sellerThreads", fields: [sellerId], references: [id])
  messages  Message[]
  createdAt DateTime @default(now())

  @@unique([itemId, buyerId, sellerId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  isRead    Boolean  @default(false)
  thread    MessageThread @relation(fields: [threadId], references: [id])
  sender    User          @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@index([threadId])
}

model Order {
  id        String      @id @default(cuid())
  itemId    String
  buyerId   String
  sellerId  String
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(12, 2) 
  item      Item        @relation(fields: [itemId], references: [id])
  buyer     User        @relation("ordersAsBuyer", fields: [buyerId], references: [id])
  seller    User        @relation("ordersAsSeller", fields: [sellerId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}